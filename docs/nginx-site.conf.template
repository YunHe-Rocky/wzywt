# Project Nginx reverse-proxy template.
# Replace every __PLACEHOLDER__ from the same project deployment configuration,
# back up the existing site file, run nginx -t, then reload explicitly.

server {
    listen 80;
    server_name __SERVER_NAME__;

    access_log /var/log/nginx/__PROJECT_NAME__-access.log;
    error_log  /var/log/nginx/__PROJECT_NAME__-error.log;

    client_max_body_size 260m;

    location / {
        proxy_pass http://__WEB_HOST__:__WEB_PORT__;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        proxy_buffering off;
        proxy_cache off;
        proxy_request_buffering off;
        chunked_transfer_encoding on;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    location /_next/static {
        proxy_pass http://__WEB_HOST__:__WEB_PORT__;
        proxy_cache_valid 200 1d;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location /public {
        proxy_pass http://__WEB_HOST__:__WEB_PORT__;
        proxy_cache_valid 200 1d;
        add_header Cache-Control "public, max-age=31536000";
    }
}

# Install HTTPS in a separate, backed-up host-maintenance transaction. The
# certificate/key paths and server_name are host configuration, not app-release
# defaults. Do not make the app deployment stop/start or install global Nginx.
