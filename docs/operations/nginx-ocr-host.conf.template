# Optional bridge from app containers to an existing loopback-only host OCR.
# Replace __DOCKER_HOST_IP__ with the Docker host-gateway IPv4 address.
# Find it on Linux with: docker network inspect bridge --format '{{(index .IPAM.Config 0).Gateway}}'
# Install in the existing Nginx include directory, then nginx -t and reload.
# The OCR process remains on 127.0.0.1:8010; no public OCR virtual host is added.
server {
    listen __DOCKER_HOST_IP__:8011;
    server_name _;
    client_max_body_size 73m;

    location = /health {
        proxy_pass http://127.0.0.1:8010;
        proxy_set_header Authorization $http_authorization;
        proxy_read_timeout 15s;
    }

    location = /recognize {
        proxy_pass http://127.0.0.1:8010;
        proxy_http_version 1.1;
        proxy_set_header Authorization $http_authorization;
        proxy_request_buffering off;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }

    location / { return 404; }
}
