# Ordinary application environment. The deployment script discovers the project
# name, source/runtime paths, current user, PM2 home, commands and Git upstream.
PORT=8001
HOST=127.0.0.1

# MySQL connection string; production should bound pool and connection waits.
# mysql://USER:PASSWORD@HOST:3306/DB?connection_limit=10&connect_timeout=5&pool_timeout=10
DATABASE_URL=

# Required in production, at least 32 characters.
SESSION_SECRET=
# Leave empty for secure production defaults. Set to 0 only on a trusted HTTP-only LAN.
SESSION_COOKIE_SECURE=

# Optional cache and distributed lock backend.
REDIS_URL=
# Set to 1 when Redis loss must fail readiness checks.
REDIS_REQUIRED=0

# Leave storage paths empty to use the automatically managed shared runtime area.
MEDIA_STORAGE_DIR=
AVATAR_DIR=

# Optional OCR provider using the documented six-image multipart contract.
MATCH_OCR_ENDPOINT=
MATCH_OCR_TOKEN=

# Development-only seed credentials.
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_SECURITY_ANSWER=
SEED_USER_PASSWORD=
