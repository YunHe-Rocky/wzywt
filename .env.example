# Copy to .env, fill the three required values, then run:
#   chmod 600 .env
#   bash scripts/deploy.sh --check
#
# Do not commit .env. Use plain text: do not escape #, _, @ or : with a
# backslash, and do not paste Markdown links such as [url](url).

# Required in production. URL-encode special characters in the password.
# Example shape only:
# mysql://APP_USER:URL_ENCODED_PASSWORD@127.0.0.1:3306/APP_DB?connection_limit=10&connect_timeout=5&pool_timeout=10
DATABASE_URL=

# Required in production; use a newly generated random value of at least 32 characters.
SESSION_SECRET=

# Required for deployed releases: the browser-facing address, without a path.
# Production (default): HTTPS, e.g. https://game.example.com
# Local testing: HTTP on localhost or a private IP, e.g. http://192.168.1.73:8001
PUBLIC_ORIGIN=

# For a VM without HTTPS, uncomment these and set PUBLIC_ORIGIN above:
# DEPLOY_ENVIRONMENT=local
# HOST=0.0.0.0
# PORT=8001
# DEPLOY_ENVIRONMENT defaults to production; only production/local are accepted.
# Local cookies follow PUBLIC_ORIGIN: HTTP -> non-Secure, HTTPS -> Secure.
# Remove old SESSION_COOKIE_SECURE overrides when switching protocols.
# Keep test database, Redis and SESSION_SECRET separate from production.

# Optional Redis. Leave both lines commented when Redis is not used.
# REDIS_URL=redis://127.0.0.1:6379/0
# REDIS_REQUIRED=0
# Password authentication (default user): redis://:URL_ENCODED_PASSWORD@127.0.0.1:6379/0
# Repair safely: node scripts/redis-doctor.mjs --set-password --username default
# With release-only dependencies, add --dependencies /absolute/path/to/installed/release

# Optional high-entropy token for internal readiness metrics. Send it only in
# X-Health-Details-Token; never put it in a URL, browser bundle, or public log.
# HEALTH_DETAILS_TOKEN=

# Optional OCR provider. Leave commented when OCR is not configured.
# MATCH_OCR_ENDPOINT=https://ocr.example.com/recognize
# MATCH_OCR_TOKEN=
# Local VM only (DEPLOY_ENVIRONMENT=local): HTTP on localhost/loopback/private IP.
# MATCH_OCR_ENDPOINT=http://127.0.0.1:8010/recognize
# Keep NODE_ENV=production for deployed builds; default production still requires HTTPS.
# The bundled OCR preview supports DATA only, not the website's six-page workflow.

# Optional external database backup directory. It must be an absolute path
# writable by the deployment user. The default is <runtime>/shared/mysql-bak.
# DEPLOY_DB_BACKUP_DIR=/opt/backups/wzywt/mysql

# Optional number of release directories retained after a successful deploy.
# The active and previous rollback releases are always protected. Default: 5.
# DEPLOY_RELEASE_RETENTION=5

# Normal deployments do not need more settings:
# - HOST defaults to 127.0.0.1 and PORT defaults to 8001.
# - production cookies are Secure by default.
# - media and avatars go to <runtime>/shared/media automatically.
# - project paths, user/group, Git branch, PM2 names/home, command paths,
#   health retries and the default backup path are discovered by scripts/deploy.sh.
#
# Only consult docs/operations/deploy-advanced.md when preflight names a specific override.
