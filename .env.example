# Copy to .env, fill the three required values, then run:
#   chmod 600 .env
#   bash scripts/deploy.sh --check
#
# Do not commit .env. Use plain text: do not escape #, _, @ or : with a
# backslash, and do not paste Markdown links such as [url](url).

# Required in production. URL-encode special characters in the password.
# Example shape only:
# mysql://APP_USER:URL_ENCODED_PASSWORD@127.0.0.1:3306/APP_DB?connection_limit=10&connect_timeout=5&pool_timeout=10
DATABASE_URL=

# Required in production; use a newly generated random value of at least 32 characters.
SESSION_SECRET=

# Required for deployed releases: the browser-facing address, without a path.
# Production (default): HTTPS, e.g. https://game.example.com
# Local testing: HTTP on localhost or a private IP, e.g. http://192.168.1.73:8001
PUBLIC_ORIGIN=

# For a VM without HTTPS, uncomment these and set PUBLIC_ORIGIN above:
# DEPLOY_ENVIRONMENT=local
# HOST=0.0.0.0
# PORT=8001
# DEPLOY_ENVIRONMENT defaults to production; only production/local are accepted.
# Local cookies follow PUBLIC_ORIGIN: HTTP -> non-Secure, HTTPS -> Secure.
# Remove old SESSION_COOKIE_SECURE overrides when switching protocols.
# Keep test database, Redis and SESSION_SECRET separate from production.

# Redis is used by the shared API admission/cache layer. Compose requires it.
# Native development can leave it optional; set REDIS_REQUIRED=1 when deploying with Redis.
# REDIS_URL=redis://127.0.0.1:6379/0
# REDIS_REQUIRED=0
# Password authentication (default user): redis://:URL_ENCODED_PASSWORD@127.0.0.1:6379/0
# Repair safely: node scripts/redis-doctor.mjs --set-password --username default
# With release-only dependencies, add --dependencies /absolute/path/to/installed/release

# Optional high-entropy token for internal readiness metrics. Send it only in
# X-Health-Details-Token; never put it in a URL, browser bundle, or public log.
# HEALTH_DETAILS_TOKEN=

# Optional OCR provider. Keep only ONE active assignment per key in this file.
# MATCH_OCR_ENDPOINT=
# MATCH_OCR_TOKEN=
# MATCH_OCR_INTERNAL_HOST=
# Local VM: set DEPLOY_ENVIRONMENT=local at its existing line above; endpoint may be
# http://127.0.0.1:8010/recognize when website and OCR run on the SAME VM.
# Production: keep production mode. SAME-host OCR may use http://127.0.0.1:8010/recognize;
# other OCR endpoints (including a LAN IP) require HTTPS unless explicitly opting
# into a private Compose service: MATCH_OCR_INTERNAL_HOST=ocr with
# MATCH_OCR_ENDPOINT=http://ocr:8010/recognize. Only that exact hostname is allowed.
# Set MATCH_OCR_TOKEN to the OCR token CONTENT, not its filename. Never paste it publicly.
# Use plain URLs, not [url](url). --check validates OCR config without printing the token.
# Keep NODE_ENV=production for deployed builds; the public website still requires HTTPS.
# The bundled OCR supports the six-page workflow; results require human review.

# Optional external database backup directory. It must be an absolute path
# writable by the deployment user. The default is <runtime>/shared/mysql-bak.
# DEPLOY_DB_BACKUP_DIR=/opt/backups/wzywt/mysql

# Optional number of release directories retained after a successful deploy.
# The active and previous rollback releases are always protected. Default: 5.
# DEPLOY_RELEASE_RETENTION=5

# Normal deployments do not need more settings:
# - HOST defaults to 127.0.0.1 and PORT defaults to 8001.
# - production cookies are Secure by default.
# - media and avatars go to <runtime>/shared/media automatically.
# - project paths, user/group, Git branch, PM2 names/home, command paths,
#   health retries and the default backup path are discovered by scripts/deploy.sh.
#
# Only consult docs/operations/deploy-advanced.md when preflight names a specific override.

COMBAT_VIDEO_UPLOAD_TIMEOUT_SECONDS=900
COMBAT_VIDEO_MAX_SIZE_MB=512
# Video duration and byte limits are independent; both apply to uploads.
COMBAT_VIDEO_MAX_DURATION_SECONDS=300

# Adaptive resource budgets (0 = automatic host/cgroup soft budget, MiB otherwise).
RESOURCE_GOVERNOR_ENABLED=1
RESOURCE_WEB_MEMORY_MB=0
RESOURCE_CRON_MEMORY_MB=0
RESOURCE_EXTERNAL_RPS=30
RESOURCE_EXTERNAL_BURST=30
RESOURCE_EXTERNAL_CONCURRENCY=32
RESOURCE_SUBSCRIPTION_CONCURRENCY=8
RESOURCE_SUBSCRIPTION_MAX_SECONDS=300
RESOURCE_DRAIN_SECONDS=30
RESOURCE_RECLAIM_SECONDS=15
RESOURCE_INTERNAL_CONCURRENCY=4
RESOURCE_INTERNAL_QUEUE_LIMIT=32
RESOURCE_INTERNAL_MAX_WAIT_SECONDS=900
RESOURCE_RECOVERY_SECONDS=30
RESOURCE_LOG_SECONDS=30
RESOURCE_RECYCLE_SECONDS=180

# Lazy team-balancing workers. 0 concurrency = choose 1-2 from available CPUs.
# Heap limit applies to each worker's V8 old generation, not its entire RSS.
SPLIT_WORKER_CONCURRENCY=0
SPLIT_WORKER_QUEUE_LIMIT=8
SPLIT_WORKER_TIMEOUT_MS=8000
SPLIT_WORKER_IDLE_SECONDS=60
SPLIT_WORKER_HEAP_MB=64

# TRUST_PROXY=0 ignores client-supplied X-Real-IP in direct LAN mode.
# Use 1 only behind a controlled gateway that overwrites the header.
# TRUST_PROXY=0
