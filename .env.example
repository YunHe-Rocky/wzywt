# Copy to .env (chmod 600, never commit). This is the single configuration
# inventory for the app, release deployment, and documented host operations.
# Labels: [app] runtime; [deploy] deploy.sh; [ops] manual host operation.
# deploy.sh deliberately does not mutate global Nginx, TLS, or systemd state.
#
# ========================== 怎么使用这个范文 ==========================
# 1. cp .env.example .env && chmod 600 .env
# 2. 全文搜索 CHANGE_ME 和 example.com，全部替换后才能上线。
# 3. 下面范例假设：
#    - 源码在 /opt/wzywt
#    - release 在 /opt/wzywt-runtime
#    - Linux 用户/组是 wzywt
#    - NodeJS 在 /opt/runtime/NodeJS/bin
#    - 内部端口是 127.0.0.1:8001
#    - 公网域名是 game.example.com
#    - MySQL/Redis 均在本机
# 4. 不能确认路径时先查，不要猜：
#      id wzywt
#      readlink -f /opt/wzywt
#      find /opt/runtime/NodeJS -maxdepth 3 -type f -name node
#      command -v git tar curl flock mysqldump systemctl nginx certbot
#      systemctl status mysqld redis nginx --no-pager
# 5. [ops] 项是人工运维参数；写入 .env 不会自动申请证书、
#    改 Nginx 或开防火墙。操作方法见 docs/nginx-configuration.md。
#
# 生产上线前必须为空的开发 seed 项：
#   SEED_ADMIN_USERNAME / SEED_ADMIN_PASSWORD /
#   SEED_ADMIN_SECURITY_ANSWER / SEED_USER_PASSWORD
#

# [app] [deploy] Internal listener; keep loopback-only behind Nginx.
PORT=8001
HOST=127.0.0.1

# [app] [deploy] MySQL URL。密码中 @ : / # % 等字符必须 URL 编码。
# 范例：mysql://wzywt_app:CHANGE_ME_URL_ENCODED_PASSWORD@127.0.0.1:3306/wzywt?connection_limit=10&connect_timeout=5&pool_timeout=10
DATABASE_URL=

# [app] 生产必填，至少 32 字符。生成示例：
# openssl rand -base64 48
# 只把生成结果写入服务器 .env，不要回填到本范文。
SESSION_SECRET=
# Leave empty for secure production defaults. Set to 0 only on a trusted HTTP-only LAN.
SESSION_COOKIE_SECURE=

# [app] [deploy] Redis URL。本机无密码范例：redis://127.0.0.1:6379/0
# 有密码范例：redis://:CHANGE_ME_URL_ENCODED_PASSWORD@127.0.0.1:6379/0
# 不用 Redis 可留空；留空会放弃分布式锁和缓存能力。
REDIS_URL=
# Set to 1 when Redis loss must fail readiness checks.
REDIS_REQUIRED=0

# [app] [deploy] 持久化目录。推荐留空，脚本将解析为：
# MEDIA_STORAGE_DIR=/opt/wzywt-runtime/shared/media
# AVATAR_DIR=/opt/wzywt-runtime/shared/media/avatars
# 如手工填写，AVATAR_DIR 必须在 MEDIA_STORAGE_DIR 内。
MEDIA_STORAGE_DIR=
AVATAR_DIR=

# Optional OCR provider using the documented six-image multipart contract.
MATCH_OCR_ENDPOINT=
MATCH_OCR_TOKEN=

# Development-only seed credentials.
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_SECURITY_ANSWER=
SEED_USER_PASSWORD=

# Release and filesystem [deploy]。这里的路径是一套完整范例；
# 如你的源码实际在 /opt/apps/wzywt，必须同步改 DEPLOY_SOURCE_DIR。
DEPLOY_PROJECT_NAME=wangzhe-yanwutang
DEPLOY_SOURCE_DIR=/opt/wzywt
DEPLOY_BASE_DIR=/opt/wzywt-runtime
DEPLOY_RUN_USER=wzywt
DEPLOY_RUN_GROUP=wzywt
DEPLOY_REMOTE=origin
DEPLOY_BRANCH=main

# Internal health and PM2 ownership [deploy]
DEPLOY_WEB_HOST=127.0.0.1
DEPLOY_WEB_PORT=8001
DEPLOY_HEALTH_URL=http://127.0.0.1:8001/api/health
DEPLOY_HEALTH_ATTEMPTS=30
DEPLOY_HEALTH_INTERVAL_SECONDS=2
DEPLOY_HEALTH_TIMEOUT_SECONDS=3
DEPLOY_PM2_HOME=/home/wzywt/.pm2
DEPLOY_PM2_CONFIG=ecosystem.config.js
DEPLOY_PM2_WEB_NAME=wangzhe-yanwutang-web
DEPLOY_PM2_CRON_NAME=wangzhe-yanwutang-cron

# Explicit binaries are important when the runtime is below /opt [deploy].
# 注意：你已知道 /opt/runtime/NodeJS 存在，但 bin/node 仍需用
# find/readlink 确认。如 npm/pm2 在其他层级，必须改成真实可执行文件。
DEPLOY_NODE_BIN=/opt/runtime/NodeJS/bin/node
DEPLOY_NPM_BIN=/opt/runtime/NodeJS/bin/npm
DEPLOY_NPX_BIN=/opt/runtime/NodeJS/bin/npx
DEPLOY_PM2_BIN=/opt/runtime/NodeJS/bin/pm2
DEPLOY_GIT_BIN=/usr/bin/git
DEPLOY_TAR_BIN=/usr/bin/tar
DEPLOY_CURL_BIN=/usr/bin/curl
DEPLOY_FLOCK_BIN=/usr/bin/flock
DEPLOY_MYSQLDUMP_BIN=/usr/bin/mysqldump
DEPLOY_SYSTEMCTL_BIN=/usr/bin/systemctl
# Optional; leave empty unless the reviewed file has actually been installed.
DEPLOY_HOST_MANIFEST=

# Public URL, Nginx, and TLS [ops]
# 下面的 game.example.com 是范例域名，必须在所有 PUBLIC/TLS 项中
# 一次性替换为真实域名。完整 Nginx 范文：docs/nginx.conf.example
# 逐项讲解：docs/nginx-configuration.md
PUBLIC_SCHEME=https
PUBLIC_HOST=game.example.com
PUBLIC_PORT=443
NGINX_BIN=/usr/sbin/nginx
NGINX_SERVICE=nginx
NGINX_SITE_TEMPLATE=/opt/wzywt/docs/nginx.conf.example
NGINX_SITE_CONFIG=/etc/nginx/conf.d/wangzhe-yanwutang.conf
NGINX_CLIENT_MAX_BODY_SIZE=260m

# TLS_CERT_MODE 三选一：
# existing = 证书已经在服务器上；certbot = Certbot 申请/续期；
# manual = 由面板、公司 CA 或其他系统管理。
TLS_CERT_MODE=existing
# Let's Encrypt/Certbot 典型路径如下；其他 CA 改成实际路径。
TLS_CERT_FILE=/etc/letsencrypt/live/game.example.com/fullchain.pem
TLS_KEY_FILE=/etc/letsencrypt/live/game.example.com/privkey.pem
TLS_TRUSTED_CERT_FILE=
TLS_CERTBOT_BIN=/usr/bin/certbot
# Let's Encrypt 到期/安全通知邮箱，必须替换。
TLS_CERTBOT_EMAIL=admin@game.example.com
TLS_CERTBOT_WEBROOT=/var/www/certbot

# Host service and backup inventory [ops]
MYSQL_SERVICE=mysqld
REDIS_SERVICE=redis
PM2_SYSTEMD_SERVICE=pm2-wzywt
MYSQL_BACKUP_DIR=/opt/wzywt-runtime/shared/mysql-bak
MYSQL_BACKUP_RETENTION=10
PUBLIC_HEALTH_URL=https://game.example.com/api/health
