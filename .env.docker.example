# Docker 专用配置：运行 node scripts/compose.mjs init 生成私有 .env.docker。
# 通用应用配置优先维护在项目根目录 .env；本文件只保留容器配置和部署差异。
# 读取优先级：进程环境 > .env.docker（或 --env-file）> 根目录 .env > 程序默认值。
# 删除/注释某项才会继承；KEY= 会清空继承值，再使用该项默认值或触发必填校验。
# --env-file 只替换本文件，通用配置仍从项目根目录 .env 读取；不读取 .env.local。
# 可继承：Session/入口/Cookie、OCR、健康令牌、时区、代理信任、媒体/视频限制、
# RESOURCE_* / SPLIT_WORKER_* 调度配置；完整说明见 docs/operations/docker.md 第 4 节。
# 不继承原生 DATABASE_URL、MYSQL_*、Redis、HOST/PORT、媒体目录和 FFMPEG_BIN。
# 容器使用独立连接与内部路径；外部 MySQL 仍在下方填写 MYSQL_*。
# .env 可不存在：程序使用默认值，init 只为其中未配置的 Session/OCR 密钥追加随机值。
# 手机访问时在 .env 配置 PUBLIC_ORIGIN=http://本机局域网IP:8001、DEPLOY_ENVIRONMENT=local；
# 如果仅 Docker 的入口不同，在 .env.docker 追加这两项覆盖。公网入口按文档配置 HTTPS。
# 不提交私有配置；首次启动后保留凭据。值使用单行字面量，不引用其他环境变量。

COMPOSE_PROJECT_NAME=wzywt

# container：自动连接 mysql:3306；external：填写已有库/账户/密码，host 空值为 host-machine。
MYSQL_MODE=container
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=wzywt
MYSQL_USER=wzywt
MYSQL_PASSWORD=__GENERATE_MYSQL_PASSWORD__
# 仅容器 MySQL 使用 root 密码；external 模式可清空。
MYSQL_ROOT_PASSWORD=__GENERATE_MYSQL_ROOT_PASSWORD__

# Web 宿主发布地址；仅本机或经宿主 Nginx 访问时改为 127.0.0.1。
BIND_ADDRESS=0.0.0.0
PORT=8001

# 容器硬上限。应用软预算和并发参数继承 .env，缺项由共享资源模块提供默认值。
# 默认限额需匹配宿主容量；check 会在构建/停写前拒绝超额配置。
WEB_MEMORY_LIMIT=1g
CRON_MEMORY_LIMIT=768m
WEB_CPU_LIMIT=2.0
CRON_CPU_LIMIT=1.0
MYSQL_MEMORY_LIMIT=1g
MYSQL_CPU_LIMIT=1.0
MYSQL_BUFFER_POOL_SIZE=256M
MYSQL_MAX_CONNECTIONS=50
REDIS_MEMORY_LIMIT=768m
REDIS_CPU_LIMIT=0.5
# 数据上限低于进程上限，给 AOF 重写/fork 留出空间。
REDIS_MAXMEMORY=256mb
OCR_MEMORY_LIMIT=2g
OCR_CPU_LIMIT=2.0
MIGRATE_MEMORY_LIMIT=512m
STORAGE_INIT_MEMORY_LIMIT=128m
MYSQL_CLIENT_MEMORY_LIMIT=256m
# 容量规划余量（MiB），不是内核预留；计入系统/构建及同机外部服务。
COMPOSE_MEMORY_RESERVE_MB=1024
COMPOSE_EXTERNAL_MEMORY_MB=0

# volume：Docker 命名卷；rclone：同一 Linux 宿主已挂载的 OSS。
# 例：OSS_MOUNT_PATH=/mnt/oss；OSS_DATA_PATH 空值为 <OSS_MOUNT_PATH>/wzywt。
STORAGE_MODE=volume
OSS_MOUNT_PATH=
OSS_DATA_PATH=
# 空值：rclone 用 <OSS_DATA_PATH>/backups，volume 用 data/docker-backups。
# --backup-dir 优先；备份目录必须在活动媒体/英雄目录之外。
COMPOSE_BACKUP_DIR=

# off / container / external；空值按继承的 endpoint 或 --ocr 自动选择。
# external 继承 .env 中的 OCR 地址/令牌；原生回环地址需覆盖为容器可达地址。
# 手动改为 off/container 时，如 .env 已有外部地址，追加 MATCH_OCR_ENDPOINT= 清空它。
# init --ocr 会写入容器模式和内部地址；无需重复维护内部主机名。
OCR_MODE=
