# Generate a private .env.docker with: node scripts/compose.mjs init
# Do not commit .env.docker. Keep these credentials unchanged after first startup.
# The manager calls shared runtime scripts; do not duplicate these settings in YAML.
# Use single-line literal values, not references to other environment variables.
COMPOSE_PROJECT_NAME=wzywt
APP_RELEASE_ID=local
# container (default) or external (existing host/remote MySQL).
# external: fill existing DB/user/password below; host blank = host-machine.
MYSQL_MODE=container
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=wzywt
MYSQL_USER=wzywt
MYSQL_PASSWORD=__GENERATE_MYSQL_PASSWORD__
# Only container MySQL needs this root password; external mode may leave blank.
MYSQL_ROOT_PASSWORD=__GENERATE_MYSQL_ROOT_PASSWORD__
SESSION_SECRET=__GENERATE_SESSION_SECRET__

# For a phone on your LAN, set this to http://YOUR_PC_LAN_IP:8001.
# HTTP is permitted for local deployment; Internet deployment requires HTTPS.
DEPLOY_ENVIRONMENT=local
PUBLIC_ORIGIN=http://localhost:8001
# Leave blank for automatic selection from PUBLIC_ORIGIN; explicit override: 0 or 1.
SESSION_COOKIE_SECURE=
BIND_ADDRESS=0.0.0.0
PORT=8001

# Adaptive scheduler. Container ceilings must fit the host alongside DB/Redis/OCR.
# The scheduler lowers admission/concurrency before these hard limits are reached.
WEB_MEMORY_LIMIT=1g
CRON_MEMORY_LIMIT=768m
WEB_CPU_LIMIT=2.0
CRON_CPU_LIMIT=1.0
# All managed containers have memory/CPU/PID ceilings. Defaults target a host
# with sufficient capacity; check rejects oversubscription before build/stop.
MYSQL_MEMORY_LIMIT=1g
MYSQL_CPU_LIMIT=1.0
MYSQL_BUFFER_POOL_SIZE=256M
MYSQL_MAX_CONNECTIONS=50
REDIS_MEMORY_LIMIT=768m
REDIS_CPU_LIMIT=0.5
# Keep data cap below the process limit, allowing AOF rewrite/fork overhead.
REDIS_MAXMEMORY=256mb
OCR_MEMORY_LIMIT=2g
OCR_CPU_LIMIT=2.0
MIGRATE_MEMORY_LIMIT=512m
STORAGE_INIT_MEMORY_LIMIT=128m
MYSQL_CLIENT_MEMORY_LIMIT=256m
# Include OS/build overhead and any same-host external DB/OCR/other applications.
# These are planning reserves, not reservations enforced by the kernel.
COMPOSE_MEMORY_RESERVE_MB=1024
COMPOSE_EXTERNAL_MEMORY_MB=0
RESOURCE_GOVERNOR_ENABLED=1
# 0 = derive a soft budget from host/cgroup capacity; positive values are MiB.
RESOURCE_WEB_MEMORY_MB=0
RESOURCE_CRON_MEMORY_MB=0
RESOURCE_EXTERNAL_RPS=30
RESOURCE_EXTERNAL_BURST=30
RESOURCE_EXTERNAL_CONCURRENCY=32
RESOURCE_SUBSCRIPTION_CONCURRENCY=8
RESOURCE_SUBSCRIPTION_MAX_SECONDS=300
RESOURCE_DRAIN_SECONDS=30
RESOURCE_RECLAIM_SECONDS=15
RESOURCE_INTERNAL_CONCURRENCY=4
RESOURCE_INTERNAL_QUEUE_LIMIT=32
RESOURCE_INTERNAL_MAX_WAIT_SECONDS=900
RESOURCE_RECOVERY_SECONDS=30
RESOURCE_LOG_SECONDS=30
RESOURCE_RECYCLE_SECONDS=180
SPLIT_WORKER_CONCURRENCY=0
SPLIT_WORKER_QUEUE_LIMIT=8
SPLIT_WORKER_TIMEOUT_MS=8000
SPLIT_WORKER_IDLE_SECONDS=60
SPLIT_WORKER_HEAP_MB=64

# Storage: volume (default Docker volumes) or rclone (Linux OSS mount).
# Run the manager on the same Linux server as Docker and the rclone mount.
# rclone example: OSS_MOUNT_PATH=/mnt/oss, OSS_DATA_PATH=/mnt/oss/wzywt
# OSS_DATA_PATH defaults to <OSS_MOUNT_PATH>/wzywt when blank.
STORAGE_MODE=volume
OSS_MOUNT_PATH=
OSS_DATA_PATH=
# Defaults: <OSS_DATA_PATH>/backups in rclone mode; data/docker-backups otherwise.
# --backup-dir overrides this value. Use a directory outside live media/heroes.
COMPOSE_BACKUP_DIR=

# off / container / external. Blank preserves legacy endpoint/--ocr selection.
# container needs no endpoint. external needs the existing endpoint and token.
# Same host: http://host-machine:8011/recognize via the host Nginx OCR proxy.
OCR_MODE=
MATCH_OCR_ENDPOINT=
MATCH_OCR_INTERNAL_HOST=ocr
MATCH_OCR_TOKEN=__GENERATE_OCR_TOKEN__
