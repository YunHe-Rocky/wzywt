generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int      @id @default(autoincrement())
  username           String   @unique @db.VarChar(32)
  passwordHash       String   @map("password_hash") @db.VarChar(255)
  securityQuestion   String?  @map("security_question") @db.VarChar(255)
  securityAnswerHash String?  @map("security_answer_hash") @db.VarChar(255)
  role               String   @default("user") @db.VarChar(16) // user | admin
  avatar             String?  @db.VarChar(255) // 头像文件名
  gameNickname       String?  @map("game_nickname") @db.VarChar(32)
  gameId             String?  @map("game_id") @db.VarChar(64)
  isTemporary        Boolean  @default(false) @map("is_temporary")
  banned             Boolean  @default(false) // 封禁标记
  sessionVersion     Int      @default(1) @map("session_version")
  createdAt          DateTime @default(now()) @map("created_at")

  rolePreferences   RolePreference[]
  heroPowers        HeroPower[]
  tournamentPlayers TournamentPlayer[]
  tournamentAdmins  TournamentAdmin[]
  adminOperations   AdminOperation[]
  tempApplications  TempPlayerApplication[]

  @@map("users")
}

model AuthRateLimit {
  id           Int       @id @default(autoincrement())
  scope        String    @db.VarChar(32)
  keyHash      String    @map("key_hash") @db.Char(64)
  attempts     Int       @default(0)
  windowStart  DateTime  @map("window_start")
  blockedUntil DateTime? @map("blocked_until")

  @@unique([scope, keyHash])
  @@index([blockedUntil])
  @@map("auth_rate_limits")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Tournament {
  id           Int      @id @default(autoincrement())
  code         String   @unique @db.VarChar(8)
  name         String   @db.VarChar(64)
  deadline     DateTime
  status       String   @default("recruiting") @db.VarChar(16)
  isPublic     Boolean  @default(false) @map("is_public")
  announcement String?  @map("announcement") @db.Text
  splitResult  Json?    @map("split_result")
  createdAt    DateTime @default(now()) @map("created_at")

  players      TournamentPlayer[]
  admins       TournamentAdmin[]
  applications TempPlayerApplication[]
  operations   AdminOperation[]
  picks        TournamentPick[]

  @@index([isPublic, status, deadline])
  @@map("tournaments")
}

model TournamentPlayer {
  id           Int     @id @default(autoincrement())
  tournamentId Int     @map("tournament_id")
  userId       Int     @map("user_id")
  roleType     String? @map("role_type") @db.VarChar(16)
  isTemporary  Boolean @default(false) @map("is_temporary")
  isSpectator  Boolean @default(false) @map("is_spectator")
  tempName     String? @map("temp_name") @db.VarChar(32)

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  @@index([tournamentId, isSpectator])
  @@map("tournament_players")
}

model TournamentAdmin {
  id           Int    @id @default(autoincrement())
  tournamentId Int    @map("tournament_id")
  userId       Int    @map("user_id")
  role         String @db.VarChar(16)

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  @@map("tournament_admins")
}

model TempPlayerApplication {
  id           Int      @id @default(autoincrement())
  tournamentId Int      @map("tournament_id")
  applicantId  Int      @map("applicant_id")
  tempName     String?  @map("temp_name") @db.VarChar(32)
  status       String   @default("pending") @db.VarChar(16)
  createdAt    DateTime @default(now()) @map("created_at")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  applicant  User       @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, applicantId])
  @@index([tournamentId, status])
  @@map("temp_player_applications")
}

model RolePreference {
  id             Int    @id @default(autoincrement())
  userId         Int    @map("user_id")
  roleType       String @map("role_type") @db.VarChar(16)
  preferenceRank Int    @map("preference_rank")
  roleRank       Int    @default(0) @map("role_rank")
  peakScore      Int    @default(0) @map("peak_score")
  peakRank       Int    @default(0) @map("peak_rank")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleType])
  @@map("role_preferences")
}

model HeroPower {
  id         Int    @id @default(autoincrement())
  userId     Int    @map("user_id")
  roleType   String @map("role_type") @db.VarChar(16)
  heroId     Int    @map("hero_id")
  heroName   String @map("hero_name") @db.VarChar(64)
  powerScore Int    @map("power_score")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, heroId, roleType])
  @@map("hero_powers")
}

model Hero {
  id              Int      @id @default(autoincrement())
  heroId          Int      @unique @map("hero_id")
  name            String   @db.VarChar(64)
  title           String   @db.VarChar(64)
  roleType        String   @map("role_type") @db.VarChar(16)
  heroType        Int      @default(0) @map("hero_type")
  heroType2       Int      @default(0) @map("hero_type2")
  imageUrl        String   @map("image_url") @db.VarChar(255)
  skinsJson       String?  @map("skins_json") @db.Text
  skillsJson      String   @map("skills_json") @db.Text // TODO: remove after data migration to hero_skills
  dataHash        String?  @map("data_hash") @db.VarChar(64)
  mingge          Boolean  @default(false) @map("mingge")
  minggeName      String?  @map("mingge_name") @db.VarChar(64)
  minggeRelatedId Int?     @map("mingge_related_id")
  baseJson        Json?    @map("base_json") // {hp,mp,atk,ap,def,mdef,atkSpeed,moveSpeed,hpPerLv,...}
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  heroSkills             HeroSkill[]
  secondaryLaneOverrides HeroSecondaryLane[]

  @@map("heroes")
}

model HeroSkill {
  id         Int      @id @default(autoincrement())
  heroId     Int      @map("hero_id")
  skillIndex Int      @map("skill_index") // 0=passive, 1-4=skills
  name       String   @db.VarChar(64)
  cd         String   @db.VarChar(32)
  cost       String   @db.VarChar(32)
  desc       String   @db.Text
  damageType String?  @map("damage_type") @db.VarChar(8) // physical/magic/true
  dataHash   String   @map("data_hash") @db.VarChar(64)
  extraJson  Json?    @map("extra_json") // future: {base_damage, ad_bonus, ap_bonus, ...}
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  hero Hero @relation(fields: [heroId], references: [heroId], onDelete: Cascade)

  @@unique([heroId, skillIndex])
  @@map("hero_skills")
}

model Equipment {
  id          Int      @id @default(autoincrement())
  itemId      Int      @unique @map("item_id")
  name        String   @db.VarChar(64)
  price       Int      @default(0)
  imageUrl    String?  @map("image_url") @db.VarChar(255)
  atk         Int      @default(0) // 物理攻击
  ap          Int      @default(0) // 法术攻击
  def         Int      @default(0) // 物理防御
  mdef        Int      @default(0) // 法术防御
  hp          Int      @default(0) // 生命值
  mp          Int      @default(0) // 法力值
  cdReduce    Int      @default(0) @map("cd_reduce") // 冷却缩减(%)
  atkSpeed    Int      @default(0) @map("atk_speed") // 攻速(%)
  moveSpeed   Int      @default(0) @map("move_speed") // 移速
  critRate    Int      @default(0) @map("crit_rate") // 暴击率(%)
  lifesteal   Int      @default(0) // 物理吸血(%)
  passiveJson Json?    @map("passive_json") // [{name, desc, unique}]
  components  Json? // 合成路径: [itemId, itemId]
  dataHash    String?  @map("data_hash") @db.VarChar(64)
  extraJson   Json?    @map("extra_json") // future: tags, tier, etc.
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("equipment")
}

model HeroLaneOverride {
  heroId   Int    @id @map("hero_id")
  roleType String @map("role_type") @db.VarChar(16)

  @@map("hero_lane_overrides")
}

model HeroSecondaryLane {
  id       Int    @id @default(autoincrement())
  heroId   Int    @map("hero_id")
  roleType String @map("role_type") @db.VarChar(16)

  hero Hero @relation(fields: [heroId], references: [heroId], onDelete: Cascade)

  @@unique([heroId, roleType])
  @@index([roleType])
  @@map("hero_secondary_lanes")
}

model KvCache {
  key   String @id @db.VarChar(64)
  value String @db.Text

  @@map("kv_cache")
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(128)
  version   String?  @db.VarChar(32)
  brief     String   @db.VarChar(255)
  content   String?  @db.Text
  slug      String   @unique @db.VarChar(64)
  published Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("announcements")
}

model AdminOperation {
  id           Int      @id @default(autoincrement())
  tournamentId Int      @map("tournament_id")
  adminId      Int      @map("admin_id")
  action       String   @db.VarChar(32)
  targetId     Int?     @map("target_id")
  createdAt    DateTime @default(now()) @map("created_at")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  admin      User       @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([tournamentId, action, createdAt])
  @@map("admin_operations")
}

model TournamentPick {
  id           Int    @id @default(autoincrement())
  tournamentId Int    @map("tournament_id")
  userId       Int    @map("user_id")
  team         String @db.VarChar(4) // "red" or "blue"
  roleType     String @map("role_type") @db.VarChar(16)
  heroId       Int    @map("hero_id")
  equipJson    Json?  @map("equip_json") // [itemId, itemId, ...]

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  @@map("tournament_picks")
}
