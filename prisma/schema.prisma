generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int      @id @default(autoincrement())
  username           String   @unique @db.VarChar(32)
  passwordHash       String   @map("password_hash") @db.VarChar(255)
  securityQuestion   String?  @map("security_question") @db.VarChar(255)
  securityAnswerHash String?  @map("security_answer_hash") @db.VarChar(255)
  role               String   @default("user") @db.VarChar(16) // user | admin
  avatar             String?  @db.VarChar(255) // 头像文件名
  gameNickname       String?  @map("game_nickname") @db.VarChar(32)
  gameId             String?  @map("game_id") @db.VarChar(64)
  isTemporary        Boolean  @default(false) @map("is_temporary")
  banned             Boolean  @default(false) // 封禁标记
  sessionVersion     Int      @default(1) @map("session_version")
  createdAt          DateTime @default(now()) @map("created_at")

  rolePreferences      RolePreference[]
  heroPowers           HeroPower[]
  tournamentPlayers    TournamentPlayer[]
  tournamentAdmins     TournamentAdmin[]
  adminOperations      AdminOperation[]
  tempApplications     TempPlayerApplication[]
  matchesCreated       InternalMatch[]         @relation("InternalMatchCreatedBy")
  matchesSubmitted     InternalMatch[]         @relation("InternalMatchSubmittedBy")
  matchPlayers         MatchPlayer[]           @relation("MatchPlayerMember")
  matchConfirmations   MatchPlayer[]           @relation("MatchPlayerConfirmedBy")
  matchStatsConfirmed  MatchPlayerStat[]       @relation("MatchStatConfirmedBy")
  screenshotsUploaded  MatchScreenshot[]
  recognitionsStarted  MatchRecognition[]
  disputesCreated      MatchDispute[]          @relation("MatchDisputeCreatedBy")
  disputesHandled      MatchDispute[]          @relation("MatchDisputeHandledBy")
  combatPosts          CombatPost[]            @relation("CombatPostAuthor")
  combatPostsModerated CombatPost[]            @relation("CombatPostModeratedBy")
  combatPostLikes      CombatPostLike[]
  combatPostComments   CombatPostComment[]     @relation("CombatPostCommentAuthor")
  commentsModerated    CombatPostComment[]     @relation("CombatPostCommentModeratedBy")
  tacticLayersCreated  TacticLayer[]
  tacticRoutes         TacticRoute[]
  tacticMarkers        TacticMarker[]

  @@map("users")
}

model AuthRateLimit {
  id           Int       @id @default(autoincrement())
  scope        String    @db.VarChar(32)
  keyHash      String    @map("key_hash") @db.Char(64)
  attempts     Int       @default(0)
  windowStart  DateTime  @map("window_start")
  blockedUntil DateTime? @map("blocked_until")

  @@unique([scope, keyHash])
  @@index([blockedUntil])
  @@map("auth_rate_limits")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Tournament {
  id           Int      @id @default(autoincrement())
  code         String   @unique @db.VarChar(8)
  name         String   @db.VarChar(64)
  deadline     DateTime
  status       String   @default("recruiting") @db.VarChar(16)
  isPublic     Boolean  @default(false) @map("is_public")
  announcement String?  @map("announcement") @db.Text
  splitResult  Json?    @map("split_result")
  createdAt    DateTime @default(now()) @map("created_at")

  players      TournamentPlayer[]
  admins       TournamentAdmin[]
  applications TempPlayerApplication[]
  operations   AdminOperation[]
  picks        TournamentPick[]
  matches      InternalMatch[]
  combatPosts  CombatPost[]

  @@index([isPublic, status, deadline])
  @@map("tournaments")
}

model TournamentPlayer {
  id           Int     @id @default(autoincrement())
  tournamentId Int     @map("tournament_id")
  userId       Int     @map("user_id")
  roleType     String? @map("role_type") @db.VarChar(16)
  isTemporary  Boolean @default(false) @map("is_temporary")
  isSpectator  Boolean @default(false) @map("is_spectator")
  tempName     String? @map("temp_name") @db.VarChar(32)

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  @@index([tournamentId, isSpectator])
  @@map("tournament_players")
}

model TournamentAdmin {
  id           Int    @id @default(autoincrement())
  tournamentId Int    @map("tournament_id")
  userId       Int    @map("user_id")
  role         String @db.VarChar(16)

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  @@map("tournament_admins")
}

model TempPlayerApplication {
  id           Int      @id @default(autoincrement())
  tournamentId Int      @map("tournament_id")
  applicantId  Int      @map("applicant_id")
  tempName     String?  @map("temp_name") @db.VarChar(32)
  status       String   @default("pending") @db.VarChar(16)
  createdAt    DateTime @default(now()) @map("created_at")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  applicant  User       @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, applicantId])
  @@index([tournamentId, status])
  @@map("temp_player_applications")
}

model RolePreference {
  id             Int    @id @default(autoincrement())
  userId         Int    @map("user_id")
  roleType       String @map("role_type") @db.VarChar(16)
  preferenceRank Int    @map("preference_rank")
  roleRank       Int    @default(0) @map("role_rank")
  peakScore      Int    @default(0) @map("peak_score")
  peakRank       Int    @default(0) @map("peak_rank")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleType])
  @@map("role_preferences")
}

model HeroPower {
  id         Int    @id @default(autoincrement())
  userId     Int    @map("user_id")
  roleType   String @map("role_type") @db.VarChar(16)
  heroId     Int    @map("hero_id")
  heroName   String @map("hero_name") @db.VarChar(64)
  powerScore Int    @map("power_score")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, heroId, roleType])
  @@map("hero_powers")
}

model Hero {
  id              Int      @id @default(autoincrement())
  heroId          Int      @unique @map("hero_id")
  name            String   @db.VarChar(64)
  title           String   @db.VarChar(64)
  roleType        String   @map("role_type") @db.VarChar(16)
  heroType        Int      @default(0) @map("hero_type")
  heroType2       Int      @default(0) @map("hero_type2")
  imageUrl        String   @map("image_url") @db.VarChar(255)
  skinsJson       String?  @map("skins_json") @db.Text
  skillsJson      String   @map("skills_json") @db.Text // TODO: remove after data migration to hero_skills
  dataHash        String?  @map("data_hash") @db.VarChar(64)
  mingge          Boolean  @default(false) @map("mingge")
  minggeName      String?  @map("mingge_name") @db.VarChar(64)
  minggeRelatedId Int?     @map("mingge_related_id")
  baseJson        Json?    @map("base_json") // {hp,mp,atk,ap,def,mdef,atkSpeed,moveSpeed,hpPerLv,...}
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  heroSkills             HeroSkill[]
  secondaryLaneOverrides HeroSecondaryLane[]
  matchPlayers           MatchPlayer[]

  @@map("heroes")
}

model HeroSkill {
  id         Int      @id @default(autoincrement())
  heroId     Int      @map("hero_id")
  skillIndex Int      @map("skill_index") // 0=passive, 1-4=skills
  name       String   @db.VarChar(64)
  cd         String   @db.VarChar(32)
  cost       String   @db.VarChar(32)
  desc       String   @db.Text
  damageType String?  @map("damage_type") @db.VarChar(8) // physical/magic/true
  dataHash   String   @map("data_hash") @db.VarChar(64)
  extraJson  Json?    @map("extra_json") // future: {base_damage, ad_bonus, ap_bonus, ...}
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  hero Hero @relation(fields: [heroId], references: [heroId], onDelete: Cascade)

  @@unique([heroId, skillIndex])
  @@map("hero_skills")
}

model Equipment {
  id          Int      @id @default(autoincrement())
  itemId      Int      @unique @map("item_id")
  name        String   @db.VarChar(64)
  price       Int      @default(0)
  imageUrl    String?  @map("image_url") @db.VarChar(255)
  atk         Int      @default(0) // 物理攻击
  ap          Int      @default(0) // 法术攻击
  def         Int      @default(0) // 物理防御
  mdef        Int      @default(0) // 法术防御
  hp          Int      @default(0) // 生命值
  mp          Int      @default(0) // 法力值
  cdReduce    Int      @default(0) @map("cd_reduce") // 冷却缩减(%)
  atkSpeed    Int      @default(0) @map("atk_speed") // 攻速(%)
  moveSpeed   Int      @default(0) @map("move_speed") // 移速
  critRate    Int      @default(0) @map("crit_rate") // 暴击率(%)
  lifesteal   Int      @default(0) // 物理吸血(%)
  passiveJson Json?    @map("passive_json") // [{name, desc, unique}]
  components  Json? // 合成路径: [itemId, itemId]
  dataHash    String?  @map("data_hash") @db.VarChar(64)
  extraJson   Json?    @map("extra_json") // future: tags, tier, etc.
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("equipment")
}

model HeroLaneOverride {
  heroId   Int    @id @map("hero_id")
  roleType String @map("role_type") @db.VarChar(16)

  @@map("hero_lane_overrides")
}

model HeroSecondaryLane {
  id       Int    @id @default(autoincrement())
  heroId   Int    @map("hero_id")
  roleType String @map("role_type") @db.VarChar(16)

  hero Hero @relation(fields: [heroId], references: [heroId], onDelete: Cascade)

  @@unique([heroId, roleType])
  @@index([roleType])
  @@map("hero_secondary_lanes")
}

model KvCache {
  key   String @id @db.VarChar(64)
  value String @db.Text

  @@map("kv_cache")
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(128)
  version   String?  @db.VarChar(32)
  brief     String   @db.VarChar(255)
  content   String?  @db.Text
  slug      String   @unique @db.VarChar(64)
  published Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("announcements")
}

model AdminOperation {
  id           Int      @id @default(autoincrement())
  tournamentId Int      @map("tournament_id")
  adminId      Int      @map("admin_id")
  action       String   @db.VarChar(32)
  targetId     Int?     @map("target_id")
  matchId      Int?     @map("match_id")
  details      Json?
  createdAt    DateTime @default(now()) @map("created_at")

  tournament Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  admin      User           @relation(fields: [adminId], references: [id], onDelete: Restrict)
  match      InternalMatch? @relation(fields: [matchId], references: [id], onDelete: Restrict)

  @@index([tournamentId, action, createdAt])
  @@index([matchId, action, createdAt])
  @@map("admin_operations")
}

model TournamentPick {
  id           Int    @id @default(autoincrement())
  tournamentId Int    @map("tournament_id")
  userId       Int    @map("user_id")
  team         String @db.VarChar(4) // "red" or "blue"
  roleType     String @map("role_type") @db.VarChar(16)
  heroId       Int    @map("hero_id")
  equipJson    Json?  @map("equip_json") // [itemId, itemId, ...]

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  @@map("tournament_picks")
}

model InternalMatch {
  id                 Int       @id @default(autoincrement())
  tournamentId       Int       @unique @map("tournament_id")
  playedAt           DateTime  @default(now()) @map("played_at")
  status             String    @default("DRAFT") @db.VarChar(24)
  winnerSide         String?   @map("winner_side") @db.VarChar(4)
  redTotalKills      Int?      @map("red_total_kills") @db.UnsignedSmallInt
  blueTotalKills     Int?      @map("blue_total_kills") @db.UnsignedSmallInt
  consistencyStatus  String    @default("PENDING") @map("consistency_status") @db.VarChar(16)
  consistencyDetails Json?     @map("consistency_details")
  createdById        Int       @map("created_by")
  submittedById      Int?      @map("submitted_by")
  submittedAt        DateTime? @map("submitted_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  tournament   Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
  createdBy    User               @relation("InternalMatchCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  submittedBy  User?              @relation("InternalMatchSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  players      MatchPlayer[]
  screenshots  MatchScreenshot[]
  recognitions MatchRecognition[]
  disputes     MatchDispute[]
  operations   AdminOperation[]
  combatPosts  CombatPost[]
  tacticRooms  TacticRoom[]

  @@index([playedAt])
  @@index([status])
  @@map("internal_matches")
}

model MatchPlayer {
  id                    Int       @id @default(autoincrement())
  matchId               Int       @map("match_id")
  side                  String    @db.VarChar(4)
  slot                  Int       @db.UnsignedTinyInt
  memberId              Int?      @map("member_id")
  isGuest               Boolean   @default(false) @map("is_guest")
  gameNickname          String    @map("game_nickname") @db.VarChar(32)
  heroId                Int?      @map("hero_id")
  heroName              String?   @map("hero_name") @db.VarChar(64)
  roleType              String?   @map("role_type") @db.VarChar(16)
  score                 Decimal?  @db.Decimal(6, 2)
  isWinner              Boolean?  @map("is_winner")
  identityConfirmedAt   DateTime? @map("identity_confirmed_at")
  identityConfirmedById Int?      @map("identity_confirmed_by")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  match               InternalMatch    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  member              User?            @relation("MatchPlayerMember", fields: [memberId], references: [id], onDelete: Restrict)
  hero                Hero?            @relation(fields: [heroId], references: [heroId], onDelete: Restrict)
  identityConfirmedBy User?            @relation("MatchPlayerConfirmedBy", fields: [identityConfirmedById], references: [id], onDelete: Restrict)
  stats               MatchPlayerStat?
  disputes            MatchDispute[]

  @@unique([matchId, side, slot])
  @@unique([matchId, memberId])
  @@index([matchId])
  @@index([memberId])
  @@index([heroId])
  @@map("match_players")
}

model MatchPlayerStat {
  id                   Int       @id @default(autoincrement())
  matchPlayerId        Int       @unique @map("match_player_id")
  damageDealt          Int?      @map("damage_dealt") @db.UnsignedInt
  damageTaken          Int?      @map("damage_taken") @db.UnsignedInt
  gold                 Int?      @db.UnsignedInt
  participationRate    Decimal?  @map("participation_rate") @db.Decimal(8, 4)
  damageConversionRate Decimal?  @map("damage_conversion_rate") @db.Decimal(8, 4)
  damageTakenPerDeath  Int?      @map("damage_taken_per_death") @db.UnsignedInt
  jungleGold           Int?      @map("jungle_gold") @db.UnsignedInt
  minionKills          Int?      @map("minion_kills") @db.UnsignedInt
  kills                Int?      @db.UnsignedSmallInt
  deaths               Int?      @db.UnsignedSmallInt
  assists              Int?      @db.UnsignedSmallInt
  controlScore         Decimal?  @map("control_score") @db.Decimal(10, 2)
  healing              Int?      @db.UnsignedInt
  towerDamage          Int?      @map("tower_damage") @db.UnsignedInt
  confirmedAt          DateTime? @map("confirmed_at")
  confirmedById        Int?      @map("confirmed_by")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  matchPlayer MatchPlayer @relation(fields: [matchPlayerId], references: [id], onDelete: Cascade)
  confirmedBy User?       @relation("MatchStatConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)

  @@map("match_player_stats")
}

model MatchScreenshot {
  id                 Int      @id @default(autoincrement())
  matchId            Int      @map("match_id")
  type               String   @db.VarChar(16)
  storageKey         String   @unique @map("storage_key") @db.VarChar(255)
  originalFilename   String   @map("original_filename") @db.VarChar(255)
  mimeType           String   @map("mime_type") @db.VarChar(64)
  size               Int      @db.UnsignedInt
  sha256             String   @db.Char(64)
  uploadedById       Int      @map("uploaded_by")
  recognitionStatus  String   @default("PENDING") @map("recognition_status") @db.VarChar(16)
  recognitionPayload Json?    @map("recognition_payload")
  createdAt          DateTime @default(now()) @map("created_at")

  match      InternalMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  uploadedBy User          @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@unique([matchId, type])
  @@index([matchId])
  @@index([matchId, type])
  @@map("match_screenshots")
}

model MatchRecognition {
  id               Int       @id @default(autoincrement())
  matchId          Int       @map("match_id")
  status           String    @default("PENDING") @db.VarChar(16)
  engine           String    @db.VarChar(64)
  startedById      Int       @map("started_by")
  rawResult        Json?     @map("raw_result")
  normalizedResult Json?     @map("normalized_result")
  warnings         Json?
  errorCode        String?   @map("error_code") @db.VarChar(64)
  startedAt        DateTime? @map("started_at")
  finishedAt       DateTime? @map("finished_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  match     InternalMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  startedBy User          @relation(fields: [startedById], references: [id], onDelete: Restrict)

  @@index([matchId, createdAt])
  @@map("match_recognitions")
}

model MatchDispute {
  id            Int       @id @default(autoincrement())
  matchId       Int       @map("match_id")
  matchPlayerId Int?      @map("match_player_id")
  field         String?   @db.VarChar(64)
  currentValue  Json?     @map("current_value")
  message       String    @db.VarChar(1000)
  status        String    @default("pending") @db.VarChar(16)
  createdById   Int       @map("created_by")
  handledById   Int?      @map("handled_by")
  handledAt     DateTime? @map("handled_at")
  resolution    String?   @db.VarChar(1000)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  match       InternalMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchPlayer MatchPlayer?  @relation(fields: [matchPlayerId], references: [id], onDelete: SetNull)
  createdBy   User          @relation("MatchDisputeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  handledBy   User?         @relation("MatchDisputeHandledBy", fields: [handledById], references: [id], onDelete: Restrict)

  @@index([matchId])
  @@index([status, createdAt])
  @@map("match_disputes")
}

model CombatPost {
  id               Int       @id @default(autoincrement())
  tournamentId     Int?      @map("tournament_id")
  matchId          Int?      @map("match_id")
  authorId         Int       @map("author_id")
  title            String    @db.VarChar(128)
  content          String    @db.Text
  videoStorageKey  String    @unique @map("video_storage_key") @db.VarChar(255)
  originalFilename String    @map("original_filename") @db.VarChar(255)
  mimeType         String    @map("mime_type") @db.VarChar(64)
  size             Int       @db.UnsignedInt
  sha256           String    @db.Char(64)
  status           String    @default("published") @db.VarChar(16)
  moderatedById    Int?      @map("moderated_by")
  moderatedAt      DateTime? @map("moderated_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tournament  Tournament?         @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  match       InternalMatch?      @relation(fields: [matchId], references: [id], onDelete: SetNull)
  author      User                @relation("CombatPostAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  moderatedBy User?               @relation("CombatPostModeratedBy", fields: [moderatedById], references: [id], onDelete: Restrict)
  likes       CombatPostLike[]
  comments    CombatPostComment[]

  @@index([status, createdAt])
  @@index([matchId])
  @@index([tournamentId])
  @@map("combat_posts")
}

model CombatPostLike {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  post CombatPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
  @@map("combat_post_likes")
}

model CombatPostComment {
  id            Int       @id @default(autoincrement())
  postId        Int       @map("post_id")
  authorId      Int       @map("author_id")
  content       String    @db.VarChar(1000)
  status        String    @default("active") @db.VarChar(16)
  moderatedById Int?      @map("moderated_by")
  moderatedAt   DateTime? @map("moderated_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  post        CombatPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author      User       @relation("CombatPostCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  moderatedBy User?      @relation("CombatPostCommentModeratedBy", fields: [moderatedById], references: [id], onDelete: Restrict)

  @@index([postId, status, createdAt])
  @@map("combat_post_comments")
}

model TacticRoom {
  id        Int      @id @default(autoincrement())
  matchId   Int      @map("match_id")
  side      String   @db.VarChar(4)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  match  InternalMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  layers TacticLayer[]

  @@unique([matchId, side])
  @@map("tactic_rooms")
}

model TacticLayer {
  id          Int      @id @default(autoincrement())
  roomId      Int      @map("room_id")
  name        String   @db.VarChar(64)
  sortOrder   Int      @map("sort_order")
  startTime   Int?     @map("start_time") @db.UnsignedInt
  endTime     Int?     @map("end_time") @db.UnsignedInt
  description String?  @db.VarChar(1000)
  createdById Int      @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  room      TacticRoom     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdBy User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  routes    TacticRoute[]
  markers   TacticMarker[]

  @@unique([roomId, sortOrder])
  @@index([roomId])
  @@map("tactic_layers")
}

model TacticRoute {
  id            Int      @id @default(autoincrement())
  layerId       Int      @map("layer_id")
  ownerMemberId Int      @map("owner_member_id")
  colorKey      String   @map("color_key") @db.VarChar(16)
  geometry      Json
  revision      Int      @default(1) @db.UnsignedInt
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  layer       TacticLayer @relation(fields: [layerId], references: [id], onDelete: Cascade)
  ownerMember User        @relation(fields: [ownerMemberId], references: [id], onDelete: Restrict)

  @@unique([layerId, ownerMemberId])
  @@index([ownerMemberId])
  @@map("tactic_routes")
}

model TacticMarker {
  id            Int      @id @default(autoincrement())
  layerId       Int      @map("layer_id")
  ownerMemberId Int      @map("owner_member_id")
  type          String   @db.VarChar(16)
  x             Decimal  @db.Decimal(7, 6)
  y             Decimal  @db.Decimal(7, 6)
  text          String?  @db.VarChar(120)
  revision      Int      @default(1) @db.UnsignedInt
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  layer       TacticLayer @relation(fields: [layerId], references: [id], onDelete: Cascade)
  ownerMember User        @relation(fields: [ownerMemberId], references: [id], onDelete: Restrict)

  @@index([layerId, ownerMemberId])
  @@map("tactic_markers")
}
